{
  "category": "video",
  "schema_version": 1,
  "roles": [
    "resolver"
  ],
  "id": "generic_kvs",
  "version": "1.0.0",
  "display_name": "KVS video sites",
  "hosts": [
    "*kvs*",
    "*tube*",
    "*video*"
  ],
  "match": {
    "schemes": [
      "https",
      "http"
    ],
    "path_regex": ".*"
  },
  "capabilities": {
    "http": true,
    "folders": false,
    "refresh": true,
    "ranges": true
  },
  "limits": {
    "max_concurrent_items": 2,
    "requests_per_second": 3
  },
  "hooks": {
    "resolve": "resolve",
    "refresh": "refresh"
  }
}
