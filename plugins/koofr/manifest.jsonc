{
  "category": "cloud",
  "capabilities": {
    "folders": true,
    "http": true,
    "ranges": true,
    "refresh": true
  },
  "display_name": "Koofr",
  "hooks": {
    "enumerate": "enumerate",
    "refresh": "refresh",
    "resolve": "resolve"
  },
  "hosts": [
    "koofr.eu",
    "koofr.net",
    "k00.fr",
    "app.koofr.net"
  ],
  "id": "koofr",
  "implementation": "python",
  "limits": {
    "max_concurrent_items": 2,
    "requests_per_second": 3
  },
  "match": {
    "path_regex": ".*",
    "schemes": [
      "https",
      "http"
    ]
  },
  "permissions": {
    "hosts": [
      "koofr.eu",
      "koofr.net",
      "k00.fr",
      "app.koofr.net"
    ],
    "secrets": []
  },
  "roles": [
    "resolver"
  ],
  "schema_version": 2,
  "version": "cyberdrop-import-cyberdrop-import-1.0.0"
}
