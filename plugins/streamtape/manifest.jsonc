{
  "category": "video",
  "capabilities": {
    "folders": false,
    "http": true,
    "ranges": true,
    "refresh": true
  },
  "display_name": "Streamtape",
  "hooks": {
    "refresh": "refresh",
    "resolve": "resolve"
  },
  "hosts": [
    "streamtape.com",
    "streamtape.to",
    "streamtape.net",
    "streamta.pe"
  ],
  "id": "streamtape",
  "implementation": "python",
  "limits": {
    "max_concurrent_items": 2,
    "requests_per_second": 3
  },
  "match": {
    "path_regex": ".*",
    "schemes": [
      "https",
      "http"
    ]
  },
  "permissions": {
    "hosts": [
      "streamtape.com",
      "streamtape.to",
      "streamtape.net",
      "streamta.pe"
    ],
    "secrets": []
  },
  "roles": [
    "resolver"
  ],
  "schema_version": 2,
  "version": "cyberdrop-import-cyberdrop-import-1.0.0"
}
