{
  "category": "video",
  "capabilities": {
    "folders": false,
    "http": true,
    "ranges": true,
    "refresh": true
  },
  "display_name": "Doodstream",
  "hooks": {
    "refresh": "refresh",
    "resolve": "resolve"
  },
  "hosts": [
    "doodstream.com",
    "dood.so",
    "dood.to",
    "dood.la",
    "dood.ws",
    "dood.sh",
    "doods.pro"
  ],
  "id": "doodstream",
  "implementation": "python",
  "limits": {
    "max_concurrent_items": 2,
    "requests_per_second": 3
  },
  "match": {
    "path_regex": ".*",
    "schemes": [
      "https",
      "http"
    ]
  },
  "permissions": {
    "hosts": [
      "doodstream.com",
      "dood.so",
      "dood.to",
      "dood.la",
      "dood.ws",
      "dood.sh",
      "doods.pro"
    ],
    "secrets": []
  },
  "roles": [
    "resolver"
  ],
  "schema_version": 2,
  "version": "cyberdrop-import-cyberdrop-import-1.0.0"
}
