{
  "category": "file-host",
  "capabilities": {
    "folders": true,
    "http": true,
    "ranges": true,
    "refresh": true
  },
  "display_name": "Cyberdrop",
  "hooks": {
    "enumerate": "enumerate",
    "refresh": "refresh",
    "resolve": "resolve"
  },
  "hosts": [
    "cyberdrop.me",
    "cyberdrop.to"
  ],
  "id": "cyberdrop",
  "implementation": "python",
  "limits": {
    "max_concurrent_items": 2,
    "requests_per_second": 4
  },
  "match": {
    "path_regex": ".*",
    "schemes": [
      "https"
    ]
  },
  "permissions": {
    "secrets": [
      "cookie",
      "account_ref"
    ]
  },
  "roles": [
    "resolver"
  ],
  "schema_version": 2,
  "version": "cyberdrop-import-cyberdrop-import-1.0.0"
}
