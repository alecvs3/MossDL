{
  "category": "cloud",
  "capabilities": {
    "accounts": true,
    "folders": true,
    "http": true,
    "refresh": true
  },
  "display_name": "Google Drive",
  "hooks": {
    "enumerate": "enumerate",
    "refresh": "refresh",
    "resolve": "resolve"
  },
  "hosts": [
    "drive.google.com",
    "docs.google.com"
  ],
  "id": "google-drive",
  "implementation": "python",
  "limits": {
    "max_concurrent_items": 2,
    "requests_per_second": 4
  },
  "match": {
    "path_regex": ".*",
    "schemes": [
      "https"
    ]
  },
  "permissions": {
    "secrets": [
      "api_key",
      "cookie",
      "account_ref"
    ]
  },
  "roles": [
    "resolver"
  ],
  "schema_version": 2,
  "version": "cyberdrop-import-cyberdrop-import-1.0.0"
}
