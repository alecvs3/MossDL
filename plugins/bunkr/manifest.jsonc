{
  "category": "file-host",
  "capabilities": {
    "folders": true,
    "http": true,
    "ranges": true,
    "refresh": true
  },
  "display_name": "Bunkr",
  "hooks": {
    "enumerate": "enumerate",
    "refresh": "refresh",
    "resolve": "resolve"
  },
  "hosts": [
    "bunkr.cr",
    "bunkr.site",
    "bunkr.ph",
    "bunkr.is",
    "bunkr.black",
    "bunkr.media",
    "bunkr.red",
    "bunkr.ws"
  ],
  "id": "bunkr",
  "implementation": "python",
  "limits": {
    "max_concurrent_items": 2,
    "requests_per_second": 3
  },
  "match": {
    "path_regex": ".*",
    "schemes": [
      "https",
      "http"
    ]
  },
  "permissions": {
    "hosts": [
      "bunkr.cr",
      "bunkr.site",
      "bunkr.ph",
      "bunkr.is",
      "bunkr.black",
      "bunkr.media",
      "bunkr.red",
      "bunkr.ws"
    ],
    "secrets": []
  },
  "roles": [
    "resolver"
  ],
  "schema_version": 2,
  "version": "cyberdrop-import-cyberdrop-import-1.0.0"
}
