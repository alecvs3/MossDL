{
  "category": "any-site",
  "schema_version": 1,
  "protocol_version": 2,
  "roles": ["decrypter"],
  "id": "shortlink",
  "version": "1.0.0",
  "display_name": "Shortlinks",
  "hosts": ["*"],
  "match": { "schemes": ["http", "https"], "path_regex": ".*" },
  "capabilities": { "decrypter": true, "browser": true, "metadata": true },
  "permissions": { "network": { "redirects": 8, "response_bytes": 2097152 }, "browser": "handoff-only" },
  "limits": { "max_hops": 8, "max_response_bytes": 2097152 },
  "hooks": { "extract_links": "extract_links" }
}
